(10, 0, 1, 'Free hand weapons to fight', 'Hand Weapon', 'Free upgrade'),
(11, 0, 1, 'Free Light armors grants 6+ save', 'Light Armor', 'Free upgrade'),
(12, 0, 1, 'The Skaven embody the adage (he who runs away lives to fight another day!) All models in the Skaven army add add +1 to the total rolled to determine the distance they flee.', 'Scurry Away', 'Race special rule'),
