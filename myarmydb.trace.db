(686, 25, 20, 'Enemy have to pass ld test when they want to charge this unit', 'Pipes of piebald', 'Magic Weapon'),
(687, 20, 20, '-1 ld to enemy in base contact with units', 'Proteins of verminous doom', 'Magic Weapon'),
