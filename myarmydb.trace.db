(22, 55, 2, 'Doom-flayer', 'Doom-flayer', 'Weapon Team'),
(23, 0, 2, 'Free hand weapons to fight', 'Hand Weapon', 'Free upgrade'),
(24, 0, 2, 'Free Heavy armors grants 5+ save', 'Heavy Armor', 'Free upgrade'),
(25, 0, 2, 'The Skaven embody the adage (he who runs away lives to fight another day) All models in the Skaven army add add +1 to the total rolled to determine the distance they flee.', 'Scurry Away', 'Race special rule'),
(26, 0, 2, 'Grants More Ld for each rank (max 10Ld)', 'Strength in numbers', 'Race special rule'),

