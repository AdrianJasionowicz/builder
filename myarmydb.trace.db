de'),\000d\000a(24, 0, 2, 'Free Heavy armors grants 5+ save', 'Heavy Armor', 'Free upgrade'),\000d\000a(25, 0, 2, 'The Skaven embody the adage (he who runs away lives to fight another day!) All models in the Skaven army add add +1 to the total rolled to determine the distance they flee.', 'Scurry Away', 'Race special rule'),\000d\000a(26, 0, 2, 'Grants More Ld for each rank (max 10Ld)', 'Strength in numbers', 'Race special rule'),\000d\000a\000d\000a-- Skavenslaves\000d\000a(27, 4, 9, 'Champion', 'Champion', 'SingleBuy'),\000d\000a(28, 2, 9, 'Musician', 'Musician', 'SingleBuy'),\000d\000a(29, 0.5, 9, 'One more rank can attack', 'Spears', 'Weapon'),\000d\000a(30, 0.5, 9, 'Slings', 'Slings', 'Weapon'),\000d\000a(31, 0.5, 9, 'Shields grants 6+ save and 6+ ward save in front', 'Shield', 'Weapon'),\000d\000a(32, 0, 9, 'Automatically passes all Panic test except of other skavenslaves', 'Expendable', 'Free upgrade'),\000d\000a(33, 0, 9, 'If unit breaks from combat all unit within d6 range suffers d3 s3 dmg from each rank left', 'Cornered rats', 'Free upgrade'),\000d\000a(34, 0, 9, 'The Skaven embody the adage (he who runs away lives to fight another day!) All models in the Skaven army add add +1 to the total rolled to determine the distance they flee.', 'Scurry Away', 'Race special rule'),\000d\000a(35, 0, 9, 'Grants More Ld for each rank (max 10Ld)', 'Strength in numbers', 'Race special rule'),\000d\000a\000d\000a-- Plague Priest\000d\000a(36, 0, 14, 'Grants One spell', 'Level 1 Wizard', 'Magic'),\000d\000a(37, 35, 14, 'Grants One more spell', 'Level 2 Wizard', 'Magic'),\000d\000a(38, 16, 14, 'All units around must pass Toughness test', 'Plague Censer', 'Weapon'),\000d\000a(39, 4, 14, 'Grants +2 Strength in first turn of combat', 'Flail', 'Weapon'),\000d\000a(40, 2, 14, 'Grants One more attack', 'Additional hand Weapon', 'Weapon'),\000d\000a(41, 30, 14, 'Big rat on rat', 'Great Pox Rat', 'Mount'),\000d\000a(42, 150, 14, 'Plague Furnace', 'Plague Furnace', 'RARE'),\000d\00