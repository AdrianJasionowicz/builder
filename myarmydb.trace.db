INSERT INTO UPGRADE (ID, POINTS_COST, UNIT_ID, DESCRIPTION, NAME, UPGRADE_TYPE) VALUES
(62, 200, 10, 'Screaming Bell', 'Screaming Bell', 'Mount'),
(63, 4, 10, 'Musician', 'Musician', 'SingleBuy'),
(64, 8, 10, 'Standard Bearer', 'Standard Bearer', 'SingleBuy'),
(65, 0.5, 10, 'Spears', 'Spears', 'Weapon'),
(66, 0.5, 10, 'Shields', 'Shields', 'Weapon'),
(67, 65, 10, 'Special Weapon Team', 'Poisoned Wind Mortar', 'Weapon Team'),
(68, 70, 10, 'Special Weapon Team', 'Warp Fire Thrower', 'Weapon Team'),

(69, 15, 10, 'Warpmusket: a rifle like a warplock jezzail. Range 24 inches, Strength 5, Armour Piercing, uses Unstable Ammunition. Can move or fire. Warpstone Weapon.', 'Warpmusket', 'The Scavenge-Pile'),
(70, 15, 10, 'Poisoned Attacks: all close combat attacks by this model are Poisoned. Affects tail weapons but not magic weapons or Rat Hound Bodyguard.', 'Poisoned Attacks', 'The Scavenge-Pile'),
(71, 8, 10, 'Tail Weapon: an extra appendage wielding a blade, spike, or mace. Grants 1 additional S3 attack at the model’s WS and Initiative, usable with other attacks, but has no magical properties.', 'Tail Weapon', 'The Scavenge-Pile'),
(72, 8, 10, 'Warplock Pistol: range 10in, Armour Piercing, uses Unstable Ammunition, Warpstone Weapon. Superior to other races' pistols.', 'Warplock Pistol', 'The Scavenge-Pile'),
(73, 5, 10, 'Rat Hound upgrade grants an extra WS3/S3 attack at the owner's Initiative. On a To Hit roll of 1, the hound hits its owner. Despite loyalty, verminous instincts may make it attack if the master seems vulnerable.', 'Rat Hound Bodyguard', 'The Scavenge-Pile'),

(74, 0, 10, 'A Grey Seer or Clan Skryre Warlock may use warpstone to boost magic. Declare tokens before casting; each adds a dice. Spells can use only warpstone. A 1 causes a wound. Miscasts and irresistible force apply as usual.', 'D3 Warpstone tokens', 'Free upgrade'),
