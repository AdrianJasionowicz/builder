(145, 30, 19, 'Grants Magic resistance(2)', 'Obsidian Amulet', 'Magic Weapon'),
(146, 30, 19, 'The bearer re-rolls failed armour saves', 'Dawn Stone', 'Magic Weapon'),
(147, 15, 19, 'One use only +4 ward save against the first wound suffered by bearer p503 rulebook', 'Opal Amulet', 'Magic Weapon'),
(148, 15, 19, 'Grants Magic resistance(1)', 'Obsidian Trinket', 'Magic Weapon'),
(149, 10, 19, 'The bearer has regeneration(6+) special rule', 'Seed of rebirth', 'Magic Weapon'),
(150, 5, 19, 'The bearer of the Dragonbane Gem has a 2+ ward save against flaming attacks.', 'Dragonbane gem', 'Magic Weapon'),
(151, 5, 19, 'This item grants grants the bearer a 5+ ward save against wounds caused in close combat by models that have the Fly special ', 'Pidgeon Plucker Pendant', 'Magic Weapon'),
(152, 5, 19, 'One Use Only The luck stone allows the bearer to re-roll failed armour save', 'Luckstone', 'Magic Weapon'),


(153, 0, 19, 'The Skaven embody the adage (he who runs away lives to fight another day!) All models in the Skaven army add add +1 to the total rolled to determine the distance they flee.', 'Scurry Away', 'Race special rule'),
(154, 0, 19, 'Grants More Ld for each rank (max 10Ld)', 'Strength in numbers', 'Race special rule'),
(155, 0, 19, 'Skaven may refuse a challenge without losing honour. Fleeing to safety is a leaders right. Model moves to back rank but the unit still benefits from its Leadership or Battle Standard ability.', 'Verminous Valour', 'Free upgrade'); [42000-232]
