(1, 8, 1, 'Champion', 'Clawleader', 'SingleBuy'),
(2, 4, 1, 'Musician', 'Musician', 'SingleBuy'),
(3, 8, 1, 'Standard Bearer', 'Standard Bearer', 'SingleBuy'),
