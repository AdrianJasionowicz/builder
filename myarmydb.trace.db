INSERT INTO UPGRADE (ID, POINTS_COST, UNIT_ID, DESCRIPTION, NAME, UPGRADE_TYPE) VALUES

(504, 0, 13, 'Enemy suffer -1 WS', 'Snare-net', 'Weapon'),
(505, 1, 13, '24range', 'Slings', 'Weapon'),
(506, 5, 13, 'Model with the Poisoned Attacks special rule wounds his target automatically if his natural dice roll to hit is a 6. Armour saves are modified by the Strength of the attack as normal. Note that if a Poisoned shooting attack needs to roll a 7 or more to hit, or hits automatically, then the Poisoned attacks rule does not come into play.', 'Poisoned attacks', 'Weapon'),
(507, 12, 13, '24range', 'Deathrunner', 'Weapon'),
(508, 10, 13, 'p109', 'Smokebombs', 'Weapon'),
(509, 30, 13, 'd3 wound armour piercing ', 'Weepingblade', 'Weapon'),
(510, 60, 13, 'Warp-grinder', 'Warp-grinder', 'Weapon Team'),

(511, 0, 13, 'The Skaven embody the adage (he who runs away lives to fight another day) All models in the Skaven army add add +1 to the total rolled to determine the distance they flee.', 'Scurry Away', 'Race special rule'),
(512, 0, 13, 'Check ', 'Skirmish', 'Weapon'),
(513, 0, 13, 'Check', 'Scouts', 'Weapon'),
(514, 0, 13, 'Check', 'Sneaky Infiltrators', 'Weapon'),
(515, 0, 13, 'Ward save', 'Dodge 6+ / Deathrunner 5+', 'Weapon'),
(516, 0, 13, '+1 attack', 'Two handed weapons', 'Weapon'),
(517, 0, 13, 'range weapon', 'Throwing stars', 'Weapon') [22001-232]
