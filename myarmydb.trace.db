(42, 150, 14, 'Plague Furnace', 'Plague Furnace', 'RARE'),
(43, 200, 14, 'Hand Weapon', 'Hand Weapon', 'Free'),
(44, 0, 14, 'Frenzy grants +1 attack', 'Frenzy', 'Free'),
(45, 0, 14, 'Flee 1" more', 'Scurry Away', 'Race special rule'),
(46, 0, 14, 'Grants More Ld for each rank (max 10Ld)', 'Strength in numbers', 'Race special rule'),


-- Gutter Runners
(48, 30, 13, 'Poisoned Wind Globadiers', 'Poisoned Wind Globadiers', 'SPECIAL'),
(49, 30, 13, 'Warp-grinder', 'Warp-grinder', 'Weapon Team'),

