(54, 4, 22, 'Grants +2 Strength in first turn of combat', 'Flail', 'Weapon'),
(55, 2, 22, 'Grants One more attack', 'Additional hand Weapon', 'Weapon'),
(56, 10, 22, 'Add 10 points to attack', 'Warplock Pistol', 'Weapon'),
(57, 0, 22, 'Add armor save', 'Warp Armor', 'Armor'),
(58, 15, 22, 'Add 15 points for a shield', 'Shield', 'Armor'),
(59, 20, 22, 'Add 20 points for a Warplock Pistol', 'Warplock Pistol', 'Weapon'),
(60, 0, 22, 'The Skaven embody the adage (he who runs away lives to fight another day) All models in the Skaven army add add +1 to the total rolled to determine the distance they flee.', 'Scurry Away', 'Race special rule'),
