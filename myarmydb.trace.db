INSERT INTO UPGRADE (ID, POINTS_COST, UNIT_ID, DESCRIPTION, NAME, UPGRADE_TYPE) VALUES
(156, 0, 21, '+1 Attack', 'Two hand weapons', 'Free upgrade'),
(157, 0, 21, 'Range weapon', 'Throwing stars', 'Free upgrade'),

(158, 0, 21, 'Read Rulles', 'Sneaky Infiltrator', 'Free upgrade'),
(159, 0, 21, 'Unit cant be a leader', 'A Killer, Not A Leader', 'Free upgrade'),
(160, 0, 21, 'Always strike first', 'Always Strikes First', 'Free upgrade'),
(161, 0, 21, 'Grants 4+ ward save', 'Dodge (4+)', 'Free upgrade'),
(162, 0, 21, 'Unit can start hidden in ranks', 'Hidden', 'Free upgrade'),
(163, 0, 21, 'Model with the Poisoned Attacks special rule wounds his target automatically if his natural dice roll to hit is a 6. Armour saves are modified by the Strength of the attack as normal. Note that if a Poisoned shooting attack needs to roll a 7 or more to hit, or hits automatically, then the Poisoned attacks rule does not come into play.', 'Poisoned Attacks', 'Free upgrade'),
(164, 0, 21, 'read rules ', 'Scouts', 'Free upgrade'),

(165, 15, 21, 'Warpmusket: a rifle like a warplock jezzail. Range 24 inches, Strength 5, Armour Piercing, uses Unstable Ammunition. Can move or fire. Warpstone Weapon.', 'Warpmusket', 'The Scavenge-Pile'),
(166, 15, 21, 'Poisoned Attacks: all close combat attacks by this model are Poisoned. Affects tail weapons but not magic weapons or Rat Hound Bodyguard.', 'Poisoned Attacks', 'The Scavenge-Pile'),
(167, 8, 21, 'Tail Weapon: an extra appendage wielding a blade, spike, or mace. Grants 1 additional S3 attack at the models WS and Initiative, usable with other attacks, but has no magical properties.', 'Tail Weapon', 'The Scavenge-Pile'),
(168, 8, 21, 'Warplock Pistol: range 10in, Armour Piercing, uses Unstable Ammunition, Warpstone Weapon. Superior to other races pistols.', 'Warplock Pistol', 'The Scavenge-Pile'),
(169, 5, 21, 'Rat Hound upgrade grants an extra WS3/S3 attack at the owners Initiative. On a To Hit roll of 1, the hound hits its owner. Despite loyalty, verminous instincts may make it attack if the master seems vulnerable.', 'Rat Hound Bodyguard', 'The Scavenge-Pile') [22001-232]
