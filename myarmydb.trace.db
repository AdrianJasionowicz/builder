INSERT INTO UPGRADE (ID, POINTS_COST, UNIT_ID, DESCRIPTION, NAME, UPGRADE_TYPE) VALUES
(76, 0, 19, 'Free hand weapons to fight', 'Hand weapon', 'Free upgrade'),
(77, 0, 19, 'Free Heavy armors grants 5+ save', 'Heavy armour', 'Free upgrade'),

(78, 6, 19, '+2 Str, always strike last', 'Great weapon', 'Weapon'),
(79, 3, 19, 'Shields', 'Additional hand an weapon', 'Weapon'),
(80, 3, 19, '+1 Str', 'Halberd', 'Weapon'),
(81, 3, 19, '+1 save / 6+ ward save in front', 'Shield', 'Weapon'),

(82, 65, 19, 'Upg to get unit stats', 'Rat Ogre Bonebreaker', 'Mount'),
(83, 35, 19, 'Upg to get unit stats', 'War-litter', 'Mount'),
(84, 30, 19, 'Upg to get unit stats', 'Great Pox Rat', 'Mount'),

(85, 15, 19, 'Warpmusket: a rifle like a warplock jezzail. Range 24 inches, Strength 5, Armour Piercing, uses Unstable Ammunition. Can move or fire. Warpstone Weapon.', 'Warpmusket', 'The Scavenge-Pile'),
(86, 15, 19, 'Poisoned Attacks: all close combat attacks by this model are Poisoned. Affects tail weapons but not magic weapons or Rat Hound Bodyguard.', 'Poisoned Attacks', 'The Scavenge-Pile'),
(87, 8, 19, 'Tail Weapon: an extra appendage wielding a blade, spike, or mace. Grants 1 additional S3 attack at the models WS and Initiative, usable with other attacks, but has no magical properties.', 'Tail Weapon', 'The Scavenge-Pile'),
(88, 8, 19, 'Warplock Pistol: range 10in, Armour Piercing, uses Unstable Ammunition, Warpstone Weapon. Superior to other races pistols.', 'Warplock Pistol', 'The Scavenge-Pile'),
(89, 5, 19, 'Rat Hound upgrade grants an extra WS3/S3 attack at the owners Initiative. On a To Hit roll of 1, the hound hits its owner. Despite loyalty, verminous instincts may make it attack if the master seems vulnerable.', 'Rat Hound Bodyguard', 'The Scavenge-Pile'),

(90, 30, 19, 'Magic Weapon +1 to hit', 'Sword of Striking', 'Magic Weapon'),
(91, 25, 19, 'Magic Weapon +1 to Attack', 'Sword of Battle', 'Magic Weapon'),
(92, 20, 19, 'Magic Weapon +1 to Strength', 'Sword of Might', 'Magic Weapon'),
(93, 5, 19, 'Magic Weapon -1 to armour save', 'Bitting Blade', 'Magic Weapon'),
(94, 5, 19, 'Magic armour 5+ armour save', 'Enchanted Shield', 'Magic Weapon'),
(95, 5, 19, 'Talisman grants 6+ ward save', 'Talisman of Protection', 'Magic Weapon'),
(96, 100, 19, 'Str 10 enemy must reroll all succes ward saves, any unsaved roll is multiplied to d6. Roll d6 at any end of weilder turn 3+ nothing happens, 1-2 user takes wound without armour save allowed', 'Fellblade', 'Magic Weapon'),
(97, 50, 19, 'Armour saves cannont be taken against this sword', 'Warpforged Blade', 'Magic Weapon'),
(98, 45, 19, '+1 Str +1 Attack', 'Warlock-Augumented Weapon', 'Magic Weapon'),
(99, 35, 19, '+1 Str any unsaved Wound is multipled to 2,If wielder makes a hit roll that has two or more rolls of 1 the wielder suffers wound that is multipled to 2', 'Blade of Corruption', 'Magic Weapon'),
(100, 30, 19, 'Has armour piercing each unsaved wound is multipled to d3', 'Weeping Blade', 'Magic Weapon'),
(101, 25, 19, '+1 Str to all attacks in close combat Agains Dwarfs grants armour piercing and re-rolls all failed to Wound rolls', 'Dwarfbane', 'Magic Weapon'),
(102, 10, 19, 'Enemy lose 1 T of every wound taken if his T = 0 he dies', 'Blade of Nurglitch', 'Magic Weapon'),
(103, 30, 19, 'Grants 4+ save, all succes armour saves armour inflicts S4 hit against the model that struckt the blow', 'Warpstone armour', 'Magic Weapon'),
(104, 25, 19, 'Grants 4+ save, first succesfull wound Destroys the armour and wound is discounted ', 'Worlds Edge Armour', 'Magic Weapon'),
(105, 15, 19, 'Any model in base contact suffer -1 attack (minimum 1 attack) to strike shield bearer', 'Shield of Distraction', 'Magic Weapon'),
(106, 30, 19, 'ward save 5+', 'Foul Pendant', 'Magic Weapon'),
(107, 15, 19, 'One Use Only A Skaven model can make a single enemy in game in base contact to re roll all its successful to hit dice rolls', 'Rival hide talisman', 'Magic Weapon'),
(108, 50, 19, 'A character carrying can force Clanrats of Stormvermin to drink roll d6 - 1 gone bad the unit takes d6  s3 hits , 2-3 the units has hatred of all enemies, 4-5 Frienzied units has frenzy, 6 rabid grants +2 attacks per unit and d6 automatics hits per turn', 'Skavenbrew', 'Magic Weapon'),

(109, 60, 19, '+3 Str p501 rulebook', 'Giant Blade', 'Magic Weapon'),
(110, 60, 19, '+3 Attacks p501 rulebook', 'Sword of Bloodshed', 'Magic Weapon'),
(111, 40, 19, 'Armour saves cannont be taken against wounds caused by Obsidian Blade', 'Obsidian Blade', 'Magic Weapon'),
(112, 40, 19, '+2 Str', 'Ogre Blade', 'Magic Weapon'),
(113, 40, 19, '+2 Attacks made by this sword in close combat', 'Sword of Strife', 'Magic Weapon'),
(114, 35, 19, 'Paired weapons. The bearer has Weapon skill 10', 'Fencers Blades', 'Magic Weapon'),
(115, 30, 19, 'The bearer has +1 Str and +1 for every enemy in base contact p501 rulebook', 'Sword of Anti-heroes', 'Magic Weapon'),
(116, 25, 19, 'A Wizard that suffers unsaved  wounds  from  the Spellthieving Sword loses one of his spell (determined randomly) for each unsaved wound.', 'Spellthieving Sword', 'Magic Weapon'),
(117, 25, 19, 'Always Strikes First special rule.', 'Sword of Swift Slaying', 'Magic Weapon'),
(118, 20, 19, '+1 Attack', 'Sword of Battle', 'Magic Weapon'),
(119, 20, 19, 'The bearer has the Frenzy special rule and can never lose his Frenzy', 'Berseker Sword', 'Magic Weapon'),
(120, 20, 19, 'Close combat attacks made with this sword are resolved at +1 Strength.', 'Sword of Might', 'Magic Weapon'),
(121, 15, 19, '+1 Attack', 'Gold Sigil Sword', 'Magic Weapon'),
(122, 15, 19, 'Attacks made by this sword are made at Initiative 10', 'Sword of Striking', 'Magic Weapon'),
(123, 15, 19, 'Attacks made with the Sword of Striking receive a +1 bonus to hit.', 'Sword of Striking', 'Magic Weapon'),
(124, 10, 19, 'Close combat attacks made by the Biting Blade are armour piercing.', 'Bitting Blade', 'Magic Weapon'),
(125, 10, 19, 'Attacks made with the Relic Sword will always wound on a 5+, unless they would normally need a lower result.', 'Relic Sword', 'Magic Weapon'),
(126, 10, 19, 'The bearer causes Fear', 'Shrieking Sword', 'Magic Weapon'),
(127, 5, 19, 'A monster or character that suffers an unsaved wound from the Tormentor sword has the Stupidity special rule for the rest of the game.', 'Tormentor Sword', 'Magic Weapon'),
(128, 5, 19, 'A monster or character that suffers unsaved wounds from Warrior Bane permanently loses one Attack for each unsaved wound (to a minimum of Attacks 1).', 'Warriors Bane', 'Magic Weapon'),

(129, 50, 19, 'The Armour of Destiny grants the Heavy armour. The Armour wearer a 4+ ward save.', 'Armour of Destiny', 'Magic Weapon'),
(131, 50, 19, 'The wearer counts his armour save as being one point higher than normal. Any successful roll to wound made against the wound made against the wearer of the Trickster's Helm must be re-rolled.', 'Tricksters helm', 'Magic Weapon'),
(132, 45, 19, 'Armour of Silvered Steel grants its wearer a 2+ armour save that cannot be improved by any means.', 'Armour of Silvered Steel', 'Magic Weapon'),
(133, 35, 19, 'Heavy armour. The Armour of Fortune grants the wearer a 5+ ward save.', 'Armour of Fortune', 'Magic Weapon'),
(134, 30, 19, 'The wearer counts his armour save as being one point higher than normal. p502 rulebook', 'Helm of Discord', 'Magic Weapon'),
(135, 25, 19, 'Light armour: Enemies suffer a-1 to hit penalty when attempting', 'Glittering Scales', 'Magic Weapon'),
(136, 25, 19, 'Shield. The bearer has +1 armour save against the shooting attacks', 'Shield of Ptolos', 'Magic Weapon'),
(137, 20, 19, 'Shield. The bearer gains Magic Resistance(1)', 'Spellshield', 'Magic Weapon'),
(138, 20, 19, 'Heavy Armour The Armour grants the wearer a 6+ ward save', 'Gamblers Armour', 'Magic Weapon'),
(139, 10, 19, 'The wearer counts his armour save as being one point higher than normal. The wearer has a 2+ ward save against flaming ', 'Dragonhelm', 'Magic Weapon'),
(140, 5, 19, 'Shield. The bearer counts his armour save as being two points higher than normal, rather than the it ur than the usual one point that a shield would normally grant', 'Enchanted Shield', 'Magic Weapon'),
(141, 5, 19, 'Shield. One use only. The first hit suffered by the bearer of the Charmed Sield is discounted on a roll of 2+.', 'Charmed Shield', 'Magic Weapon'),

